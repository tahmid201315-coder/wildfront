class_name Menus
extends CanvasLayer
## Every full-screen menu: title, slots, difficulty, settings (audio/accessibility/controls), pause, inventory, skills,
## journal, quests, world map, game over, victory and credits. Built in code so it needs no external assets.

signal new_game(slot: int, difficulty: int)
signal continue_game(slot: int)
signal resume
signal quit_to_title
signal retry
signal quit_app

var root: Control
var bg: Control
var box: Control
var nav: Array = []             # stack of Callables returning void (screens to return to)
var current: String = ""
var in_game: bool = false       # opened from pause rather than the title
var _t: float = 0.0
var _stars: Array = []
var _remap_wait: String = ""
var _remap_btn: Button = null
var screen_log: Array = []      # names of screens shown (tests)
const REMAP_ACTIONS := ["left", "right", "up", "down", "jump", "light", "heavy", "dodge", "magic", "ability", "interact", "heal"]
const CREDITS := [
	"PROJECT STARFALL: THE SHATTERED SKY", "",
	"Design, code, art, music and sound", "Claude (Anthropic), working with the player",
	"Engine", "Godot 4.3 (MIT licence)", "",
	"Every sprite, tile, song and sound effect", "is generated by code at runtime.", "No third-party art or audio is used.", "",
	"Thank you for playing.",
]


func _ready() -> void:
	layer = 30
	process_mode = Node.PROCESS_MODE_ALWAYS
	root = Control.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.theme = UI.make_theme(int(Game.settings.get("text_size", 1)))
	add_child(root)
	bg = Control.new()
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bg.draw.connect(_draw_bg)
	root.add_child(bg)
	box = Control.new()
	box.set_anchors_preset(Control.PRESET_FULL_RECT)
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(box)
	var rng := RandomNumberGenerator.new()
	rng.seed = 42
	for i in 90:
		_stars.append(Vector3(rng.randf(), rng.randf(), rng.randf_range(0.4, 2.2)))
	visible = false


func refresh_theme() -> void:
	root.theme = UI.make_theme(int(Game.settings.get("text_size", 1)))


var bg_mode := "title"   # title | dim | none


func _process(dt: float) -> void:
	_t += dt
	if visible and bg_mode != "none":
		bg.queue_redraw()


func _draw_bg() -> void:
	var vp := bg.get_viewport_rect().size
	if bg_mode == "dim":
		bg.draw_rect(Rect2(Vector2.ZERO, vp), Color(0.02, 0.03, 0.08, 0.82))
		return
	if bg_mode != "title":
		return
	for i in 24:
		var u := float(i) / 24.0
		bg.draw_rect(Rect2(0, vp.y * u, vp.x, vp.y / 24.0 + 1.0), Color(0.04, 0.05 + 0.12 * u, 0.16 + 0.22 * u))
	for s in _stars:
		var tw := 0.5 + 0.5 * sin(_t * s.z * 1.7 + s.x * 40.0)
		bg.draw_circle(Vector2(fposmod(s.x * vp.x - _t * 4.0 * s.z, vp.x), s.y * vp.y * 0.85), s.z, Color(1, 1, 1, 0.25 + 0.6 * tw))
	# the shattered Starheart with orbiting fragments
	var c := Vector2(vp.x * 0.5, vp.y * 0.3)
	bg.draw_circle(c, 56.0 + sin(_t * 2.0) * 3.0, Color(1.0, 0.9, 0.55, 0.12))
	bg.draw_circle(c, 30.0, Color(1.0, 0.95, 0.7, 0.35))
	for i in 7:
		var a := _t * 0.35 + TAU * i / 7.0
		var r := 90.0 + 14.0 * sin(_t + i)
		var p := c + Vector2(cos(a) * r * 1.6, sin(a) * r * 0.5)
		var col := Color.from_hsv(float(i) / 7.0, 0.5, 1.0)
		bg.draw_colored_polygon(PackedVector2Array([p + Vector2(0, -12), p + Vector2(8, 0), p + Vector2(0, 12), p + Vector2(-8, 0)]), col)
	for k in 3:
		var y := vp.y * (0.78 + 0.07 * k)
		var pts := PackedVector2Array([Vector2(0, vp.y), Vector2(0, y)])
		for x in range(0, int(vp.x) + 40, 40):
			pts.append(Vector2(x, y + sin(x * 0.01 + k * 2.0) * 18.0))
		pts.append(Vector2(vp.x, vp.y))
		bg.draw_colored_polygon(pts, Color(0.03 + 0.02 * k, 0.07 + 0.03 * k, 0.12 + 0.03 * k))


# ------------------------------------------------------------------ plumbing
func _clear() -> void:
	UI.clear(box)
	_remap_wait = ""


func _column(title: String, w: int = 560, anchor_y: float = 0.5) -> VBoxContainer:
	_clear()
	var c := CenterContainer.new()
	c.set_anchors_preset(Control.PRESET_FULL_RECT)
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(c)
	var p := PanelContainer.new()
	p.custom_minimum_size = Vector2(w, 0)
	c.add_child(p)
	var v := VBoxContainer.new()
	p.add_child(v)
	if title != "":
		v.add_child(UI.label(title, 34, UI.GOLD, HORIZONTAL_ALIGNMENT_CENTER))
	return v


func _focus(c: Control) -> void:
	if c != null:
		UI.focus(c)


func _show(name: String, bgm: String = "dim") -> void:
	current = name
	screen_log.append(name)
	bg_mode = bgm
	visible = true
	bg.queue_redraw()


func open_screen(fn: Callable) -> void:
	nav.append(fn)
	fn.call()


func back() -> void:
	if not nav.is_empty():
		nav.pop_back()
	if nav.is_empty():
		if in_game:
			close_all()
			resume.emit()
		return
	nav.back().call()


func close_all() -> void:
	nav.clear()
	_clear()
	visible = false
	current = ""


func _unhandled_input(e: InputEvent) -> void:
	if not visible:
		return
	if _remap_wait != "" and e is InputEventKey and e.pressed:
		_apply_remap(_remap_wait, e.physical_keycode)
		get_viewport().set_input_as_handled()
		return
	if e.is_action_pressed("pause") or e.is_action_pressed("ui_cancel"):
		if current in ["title", "gameover", "victory", "credits_scene"]:
			return
		Sfx.play("ui_back")
		back()
		get_viewport().set_input_as_handled()


# ------------------------------------------------------------------ title
func show_title() -> void:
	in_game = false
	nav.clear()
	nav.append(show_title)
	_show("title", "title")
	var v := _column("", 460)
	var t1 := UI.label("PROJECT STARFALL", 56, UI.GOLD, HORIZONTAL_ALIGNMENT_CENTER)
	var t2 := UI.label("The Shattered Sky", 28, UI.EDGE, HORIZONTAL_ALIGNMENT_CENTER)
	v.add_child(t1)
	v.add_child(t2)
	var any := false
	for s in Save.SLOTS:
		if Save.slot_info(s)["exists"]:
			any = true
	var first: Button = null
	var cont := UI.button("Continue", func() -> void: open_screen(show_slots.bind(false)))
	cont.disabled = not any
	v.add_child(cont)
	v.add_child(UI.button("New Game", func() -> void: open_screen(show_slots.bind(true))))
	v.add_child(UI.button("Settings", func() -> void: open_screen(show_settings)))
	v.add_child(UI.button("Credits", func() -> void: open_screen(show_credits)))
	if not OS.has_feature("web") and not OS.has_feature("mobile") and OS.has_feature("editor"):
		v.add_child(UI.button("Quit", func() -> void: quit_app.emit()))
	first = cont if any else v.get_child(3)
	_focus(first)


func show_slots(for_new: bool) -> void:
	_show("slots", "title")
	var v := _column("New Game: choose a slot" if for_new else "Continue: choose a save", 700)
	var first: Control = null
	for s in Save.SLOTS:
		var info := Save.slot_info(s)
		var row := HBoxContainer.new()
		var b := UI.button("Slot %d   %s" % [s + 1, info["summary"]], func() -> void:
			if for_new:
				if info["exists"]:
					open_screen(show_confirm.bind("Overwrite slot %d?\nThe existing save will be deleted." % (s + 1), func() -> void: open_screen(show_difficulty.bind(s))))
				else:
					open_screen(show_difficulty.bind(s))
			else:
				continue_game.emit(s), 0, 56)
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		b.disabled = (not for_new) and not info["exists"]
		row.add_child(b)
		if info["exists"]:
			var d := UI.button("Delete", func() -> void:
				open_screen(show_confirm.bind("Delete slot %d permanently?" % (s + 1), func() -> void:
					Save.delete_slot(s)
					nav.pop_back()
					nav.back().call())), 120, 56)
			row.add_child(d)
		v.add_child(row)
		if first == null and not b.disabled:
			first = b
	v.add_child(UI.button("Back", back))
	_focus(first)


func show_confirm(text: String, yes: Callable) -> void:
	_show("confirm", bg_mode)
	var v := _column("Are you sure?", 560)
	v.add_child(UI.label(text, 24, UI.TEXT, HORIZONTAL_ALIGNMENT_CENTER))
	var no := UI.button("No, go back", back)
	v.add_child(UI.button("Yes", func() -> void:
		nav.pop_back()   # drop the confirm screen itself
		yes.call()))
	v.add_child(no)
	_focus(no)


func show_difficulty(slot: int) -> void:
	_show("difficulty", "title")
	var v := _column("Choose your difficulty", 640)
	var notes := ["Enemies deal 40% less damage and have 30% less health. Two extra healing charges.",
		"The intended experience.", "Enemies hit 40% harder, have 35% more health and notice you from further away. One fewer healing charge."]
	var first: Control = null
	for i in Defs.DIFFICULTY.size():
		var b := UI.button("%s\n%s" % [Defs.DIFFICULTY[i]["name"], notes[i]], func() -> void:
			new_game.emit(slot, i), 0, 84)
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		v.add_child(b)
		if i == 1:
			first = b
	v.add_child(UI.button("Back", back))
	_focus(first)


func show_credits() -> void:
	_show("credits", "title")
	var v := _column("Credits", 640)
	for l in CREDITS:
		v.add_child(UI.label(l, 22, UI.TEXT, HORIZONTAL_ALIGNMENT_CENTER))
	var b := UI.button("Back", back)
	v.add_child(b)
	_focus(b)


# ------------------------------------------------------------------ pause
func show_pause() -> void:
	in_game = true
	nav.clear()
	nav.append(show_pause)
	_show("pause")
	var v := _column("Paused", 480)
	var r := UI.button("Resume", func() -> void:
		close_all()
		resume.emit())
	v.add_child(r)
	v.add_child(UI.button("World Map", func() -> void: open_screen(show_map)))
	v.add_child(UI.button("Equipment", func() -> void: open_screen(show_inventory)))
	v.add_child(UI.button("Skill Tree", func() -> void: open_screen(show_skills)))
	v.add_child(UI.button("Quests", func() -> void: open_screen(show_quests)))
	v.add_child(UI.button("Journal", func() -> void: open_screen(show_journal)))
	v.add_child(UI.button("Settings", func() -> void: open_screen(show_settings)))
	v.add_child(UI.button("Save and Quit to Title", func() -> void:
		close_all()
		quit_to_title.emit()))
	_focus(r)


func open_direct(fn: Callable) -> void:
	## Opens a sub-screen straight from gameplay (e.g. the map key)
	in_game = true
	nav.clear()
	nav.append(show_pause)
	open_screen(fn)


func _stat_line() -> Label:
	return UI.label("Level %d   XP %d/%d   Skill points %d   Star Shards %d   Aether Dust %d   Fragments %d/7" % [Game.level, Game.xp, Game.xp_needed(), Game.skill_points, Game.shards, Game.dust, Game.fragments], 20, UI.DIM, HORIZONTAL_ALIGNMENT_CENTER)


func show_map() -> void:
	_show("map")
	_clear()
	var v := _column("World Map", 900)
	var area := Control.new()
	area.custom_minimum_size = Vector2(820, 380)
	v.add_child(area)
	area.draw.connect(func() -> void:
		var sz := area.size
		area.draw_rect(Rect2(Vector2.ZERO, sz), Color(0.04, 0.07, 0.14))
		var order: Array = Defs.REGION_ORDER
		for i in order.size() - 1:
			var a: Vector2 = Defs.REGIONS[order[i]]["map_pos"] * sz
			var b2: Vector2 = Defs.REGIONS[order[i + 1]]["map_pos"] * sz
			area.draw_line(a, b2, Color(0.5, 0.7, 1.0, 0.5 if i + 1 < Game.region_unlocked else 0.15), 3.0)
		for i in order.size():
			var reg: Dictionary = Defs.REGIONS[order[i]]
			var p: Vector2 = reg["map_pos"] * sz
			var unlocked := i < Game.region_unlocked
			var col: Color = reg["accent"] if unlocked else Color(0.3, 0.3, 0.35)
			area.draw_circle(p, 22.0, Color(col.r, col.g, col.b, 0.35))
			area.draw_circle(p, 13.0, col)
			if Game.bosses.has(reg["boss"]):
				area.draw_circle(p, 6.0, Color.WHITE)
			if Game.checkpoint.get("region", "") == order[i] or (Game.checkpoint.get("level", "") as String).begins_with(order[i]):
				area.draw_arc(p, 28.0, 0, TAU, 28, UI.GOLD, 3.0)
			var font := ThemeDB.fallback_font
			area.draw_string(font, p + Vector2(-110, 46), reg["name"] if unlocked else "???", HORIZONTAL_ALIGNMENT_CENTER, 220, 18, UI.TEXT if unlocked else UI.DIM))
	v.add_child(UI.label("Gold ring: your last shrine.  White centre: guardian defeated.  Fragments %d/7" % Game.fragments, 20, UI.DIM, HORIZONTAL_ALIGNMENT_CENTER))
	var b := UI.button("Back", back)
	v.add_child(b)
	_focus(b)


func show_inventory() -> void:
	_show("inventory")
	var v := _column("Equipment", 880)
	v.add_child(_stat_line())
	var first: Control = null
	for slot_name in Defs.SLOTS:
		var cur: String = str(Game.equipped.get(slot_name, ""))
		var row := VBoxContainer.new()
		row.add_child(UI.label("%s: %s" % [slot_name.capitalize(), (Defs.EQUIPMENT[cur]["name"] if cur != "" else "empty")], 22, UI.GOLD))
		var hb := HFlowContainer.new()
		var none := false
		for eid in Defs.EQUIPMENT:
			if Defs.EQUIPMENT[eid]["slot"] == slot_name and Game.owned.has(eid):
				none = true
				var lv := int(Game.equip_lv.get(eid, 0))
				var b := UI.button("%s%s%s" % [Defs.EQUIPMENT[eid]["name"], (" +%d" % lv if lv > 0 else ""), "  (equipped)" if eid == cur else ""], func() -> void:
					if eid == cur:
						Game.unequip(slot_name)
					else:
						Game.equip(eid)
					Sfx.play("ability")
					show_inventory())
				hb.add_child(b)
				if first == null:
					first = b
		if not none:
			var nl := UI.label("nothing found yet", 18, UI.DIM)
			nl.autowrap_mode = TextServer.AUTOWRAP_OFF
			hb.add_child(nl)
		row.add_child(hb)
		var desc := ""
		if cur != "":
			desc = str(Defs.EQUIPMENT[cur]["desc"])
		row.add_child(UI.label(desc, 18, UI.DIM))
		v.add_child(row)
	v.add_child(UI.label("Abilities: " + (", ".join(PackedStringArray(Game.abilities.keys().map(func(k): return Game.ABILITY_NAMES.get(k, k)))) if not Game.abilities.is_empty() else "none yet"), 20, UI.TEXT))
	v.add_child(UI.label("Upgrade equipment with Tinka Gearsong using Aether Dust.", 18, UI.DIM))
	var bb := UI.button("Back", back)
	v.add_child(bb)
	_focus(first if first != null else bb)


func show_skills() -> void:
	_show("skills")
	var v := _column("Skill Tree", 900)
	v.add_child(_stat_line())
	var first: Control = null
	var g := GridContainer.new()
	g.columns = 2
	g.add_theme_constant_override("h_separation", 12)
	for sid in Defs.SKILLS:
		var s: Dictionary = Defs.SKILLS[sid]
		var lv := Game.skill(sid)
		var why := Game.can_buy_skill(sid)
		var b := UI.button("%s  %d/%d  [%d pt]\n%s" % [s["name"], lv, s["max"], s["cost"], s["desc"]], func() -> void:
			if Game.buy_skill(sid):
				Sfx.play("ability")
			else:
				Sfx.play("deny")
			show_skills(), 420, 84)
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		b.tooltip_text = why
		b.disabled = false
		if why != "":
			b.modulate = Color(0.7, 0.7, 0.8)
		g.add_child(b)
		if first == null:
			first = b
	v.add_child(g)
	var bb := UI.button("Back", back)
	v.add_child(bb)
	_focus(first if first != null else bb)


func show_quests() -> void:
	_show("quests")
	var v := _column("Quests", 860)
	var any := false
	for qid in Story.QUESTS:
		var st := Quests.status(qid)
		if st in ["active", "done", "claimed"]:
			any = true
			var q: Dictionary = Story.QUESTS[qid]
			var tag := "%d/%d" % [int(Game.quest_progress.get(qid, 0)), int(q["count"])]
			if st == "done":
				tag = "READY: speak to %s" % Story.NPCS[q["giver"]]["name"]
			elif st == "claimed":
				tag = "completed"
			v.add_child(UI.label("%s  (%s)\n%s   Reward: %s" % [q["title"], tag, q["desc"], Quests.reward_text(q["reward"])], 20, UI.GOLD if st == "done" else UI.TEXT))
	if not any:
		v.add_child(UI.label("No quests yet. Villagers in each region's hub have work for you.", 22, UI.DIM))
	var bb := UI.button("Back", back)
	v.add_child(bb)
	_focus(bb)


func show_journal() -> void:
	_show("journal")
	var v := _column("Journal", 900)
	var found := 0
	var sc := ScrollContainer.new()
	sc.custom_minimum_size = Vector2(840, 400)
	var inner := VBoxContainer.new()
	inner.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.add_child(inner)
	for jid in Story.JOURNALS:
		if Game.flag("journal_" + jid):
			found += 1
			var j: Dictionary = Story.JOURNALS[jid]
			inner.add_child(UI.label(j["title"], 22, UI.GOLD))
			var t := UI.label(j["text"], 20)
			t.custom_minimum_size = Vector2(800, 0)
			inner.add_child(t)
	if found == 0:
		inner.add_child(UI.label("You have not found any pages yet. Look for glowing notes in every region.", 22, UI.DIM))
	v.add_child(UI.label("Pages found: %d/%d" % [found, Story.JOURNALS.size()], 20, UI.DIM, HORIZONTAL_ALIGNMENT_CENTER))
	v.add_child(sc)
	var bb := UI.button("Back", back)
	v.add_child(bb)
	_focus(bb)


# ------------------------------------------------------------------ settings
func show_settings() -> void:
	_show("settings")
	var v := _column("Settings", 980)
	var tabs := TabContainer.new()
	tabs.custom_minimum_size = Vector2(920, 400)
	v.add_child(tabs)
	var S := Game.settings
	var audio := VBoxContainer.new()
	audio.name = "Audio"
	audio.add_child(UI.slider_row("Master volume", float(S["master"]), func(x: float) -> void: Game.apply_setting("master", x)))
	audio.add_child(UI.slider_row("Music volume", float(S["music"]), func(x: float) -> void: Game.apply_setting("music", x)))
	audio.add_child(UI.slider_row("Effects volume", float(S["sfx"]), func(x: float) -> void: Game.apply_setting("sfx", x)))
	audio.add_child(UI.check_row("Mute all", bool(S["mute"]), func(x: bool) -> void: Game.apply_setting("mute", x)))
	audio.add_child(UI.check_row("Sound captions (subtitles for important sounds)", bool(S.get("subtitles", false)), func(x: bool) -> void: Game.apply_setting("subtitles", x)))
	tabs.add_child(audio)
	var play := VBoxContainer.new()
	play.name = "Gameplay"
	play.add_child(UI.option_row("Difficulty", Defs.DIFFICULTY.map(func(d): return d["name"]), int(S["difficulty"]), func(i: int) -> void: Game.apply_setting("difficulty", i)))
	play.add_child(UI.check_row("Screen shake", bool(S["shake"]), func(x: bool) -> void: Game.apply_setting("shake", x)))
	play.add_child(UI.check_row("Reduce flashing", bool(S["flash_reduce"]), func(x: bool) -> void: Game.apply_setting("flash_reduce", x)))
	play.add_child(UI.option_row("Particles", ["Minimal", "Reduced", "Full"], int(S["particles"]), func(i: int) -> void: Game.apply_setting("particles", i)))
	play.add_child(UI.check_row("Show hints", bool(S["hints"]), func(x: bool) -> void: Game.apply_setting("hints", x)))
	play.add_child(UI.check_row("Controller vibration", bool(S["vibration"]), func(x: bool) -> void: Game.apply_setting("vibration", x)))
	tabs.add_child(play)
	var acc := VBoxContainer.new()
	acc.name = "Display"
	acc.add_child(UI.option_row("Text size", ["Small", "Medium", "Large"], int(S["text_size"]), func(i: int) -> void:
		Game.apply_setting("text_size", i)
		refresh_theme()
		show_settings()))
	acc.add_child(UI.check_row("High contrast UI", bool(S["high_contrast"]), func(x: bool) -> void:
		Game.apply_setting("high_contrast", x)
		refresh_theme()
		show_settings()))
	acc.add_child(UI.option_row("Graphics quality", ["Low", "Medium", "High"], int(S["quality"]), func(i: int) -> void: Game.apply_setting("quality", i)))
	tabs.add_child(acc)
	var touch := VBoxContainer.new()
	touch.name = "Touch"
	touch.add_child(UI.slider_row("Button size", float(S["ctrl_scale"]), func(x: float) -> void: Game.apply_setting("ctrl_scale", x), 0.6, 1.6, 0.05))
	touch.add_child(UI.slider_row("Button opacity", float(S["ctrl_opacity"]), func(x: float) -> void: Game.apply_setting("ctrl_opacity", x), 0.2, 1.0, 0.05))
	touch.add_child(UI.check_row("Left-handed layout", bool(S["left_handed"]), func(x: bool) -> void: Game.apply_setting("left_handed", x)))
	tabs.add_child(touch)
	var keys := GridContainer.new()
	keys.name = "Keys"
	keys.columns = 3
	for a in REMAP_ACTIONS:
		var b := UI.button("%s: %s" % [a, _key_name(a)], func() -> void: pass, 290, 44)
		b.pressed.connect(func() -> void:
			_remap_wait = a
			_remap_btn = b
			b.text = "%s: press a key..." % a)
		keys.add_child(b)
	keys.add_child(UI.button("Reset keys", func() -> void:
		reset_keys()
		show_settings(), 290, 44))
	if not OS.has_feature("mobile") and OS.has_feature("editor"):
		tabs.add_child(keys)
	else:
		keys.queue_free()
	var bb := UI.button("Back", back)
	v.add_child(bb)
	_focus(bb)


func _key_name(a: String) -> String:
	for ev in InputMap.action_get_events(a):
		if ev is InputEventKey:
			return OS.get_keycode_string(ev.physical_keycode)
	return "-"


func _apply_remap(a: String, keycode: int) -> void:
	_remap_wait = ""
	if keycode == KEY_ESCAPE:
		show_settings()
		return
	set_key(a, keycode)
	show_settings()


static func set_key(a: String, keycode: int) -> void:
	for ev in InputMap.action_get_events(a).duplicate():
		if ev is InputEventKey:
			InputMap.action_erase_event(a, ev)
	var e := InputEventKey.new()
	e.physical_keycode = keycode
	InputMap.action_add_event(a, e)
	var keys: Dictionary = Game.settings.get("keys", {})
	keys[a] = keycode
	Game.apply_setting("keys", keys)


static func apply_saved_keys() -> void:
	var keys: Dictionary = Game.settings.get("keys", {})
	for a in keys:
		if InputMap.has_action(a):
			var kc := int(keys[a])
			for ev in InputMap.action_get_events(a).duplicate():
				if ev is InputEventKey:
					InputMap.action_erase_event(a, ev)
			var e := InputEventKey.new()
			e.physical_keycode = kc as Key
			InputMap.action_add_event(a, e)


static func reset_keys() -> void:
	var defaults := {"left": KEY_A, "right": KEY_D, "up": KEY_W, "down": KEY_S, "jump": KEY_SPACE, "light": KEY_J, "heavy": KEY_L, "dodge": KEY_SHIFT,
		"magic": KEY_I, "ability": KEY_O, "interact": KEY_E, "heal": KEY_H}
	for a in defaults:
		for ev in InputMap.action_get_events(a).duplicate():
			if ev is InputEventKey:
				InputMap.action_erase_event(a, ev)
		var e := InputEventKey.new()
		e.physical_keycode = defaults[a]
		InputMap.action_add_event(a, e)
	Game.settings.erase("keys")
	Game.apply_setting("keys", {})


# ------------------------------------------------------------------ end states
func show_gameover() -> void:
	in_game = true
	nav.clear()
	_show("gameover")
	var v := _column("Kael has fallen", 520)
	v.add_child(UI.label("The Starheart flickers... but it is not done with you yet.", 22, UI.DIM, HORIZONTAL_ALIGNMENT_CENTER))
	var r := UI.button("Retry from last shrine", func() -> void:
		close_all()
		retry.emit())
	v.add_child(r)
	v.add_child(UI.button("Quit to title", func() -> void:
		close_all()
		quit_to_title.emit()))
	_focus(r)


func show_victory(stats: String) -> void:
	in_game = false
	nav.clear()
	_show("victory", "title")
	var v := _column("The Starheart Reborn", 700)
	v.add_child(UI.label("All seven fragments are whole. Dawn returns to Aetheria.", 24, UI.TEXT, HORIZONTAL_ALIGNMENT_CENTER))
	v.add_child(UI.label(stats, 22, UI.GOLD, HORIZONTAL_ALIGNMENT_CENTER))
	var b := UI.button("Roll credits", func() -> void:
		show_credits_end())
	v.add_child(b)
	_focus(b)


func show_credits_end() -> void:
	_show("credits_scene", "title")
	var v := _column("Credits", 640)
	for l in CREDITS:
		v.add_child(UI.label(l, 22, UI.TEXT, HORIZONTAL_ALIGNMENT_CENTER))
	var b := UI.button("Return to title", func() -> void:
		close_all()
		quit_to_title.emit())
	v.add_child(b)
	_focus(b)
